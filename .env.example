# GSRTC Nexus — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Cloudflare Worker proxy URL (deployed at gsrtc-proxy.gsrtc-proxy.workers.dev)
VITE_PROXY_BASE=https://gsrtc-proxy.gsrtc-proxy.workers.dev

# GSRTC auth token — get this from:
# 1. Open https://live.gsrtc.org in browser
# 2. DevTools → Application → Local Storage → copy gsrtc_auth_token value
# 3. Paste below (starts with eyJ...)
VITE_GSRTC_TOKEN=
